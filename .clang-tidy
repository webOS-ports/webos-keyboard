# Checks worth failing a build over for this codebase.
#
# The selection is the same one maliit-framework-webos uses, and for the same
# reason: the tree is expected to come out clean under this file, so the rule for
# adding a check is that its findings are ones we will fix, not ones we will
# learn to scroll past. Two groups qualify:
#
#   1. defect classes - a leak, an out-of-range access, undefined behaviour, a
#      sign error crossing a boundary, a resource not released on some path
#   2. style, where the finding is mechanical and objective: a declaration and
#      its definition disagreeing about a parameter name, a file-scope static
#      that should be an unnamed namespace, 0 where nullptr is meant
#
# Deliberately left off, and why:
#
#   misc-include-cleaner
#       would rewrite the include block of every file in the tree, and disagrees
#       with Qt's own module headers
#   misc-const-correctness
#       a large mechanical diff through code nobody is otherwise touching; worth
#       doing, but as its own change, not as a gate
#   cppcoreguidelines-*
#       structurally incompatible with Qt: owning-memory and
#       pro-type-member-init fight the d-pointer idiom, pro-bounds-* fights the C
#       evdev API, pro-type-vararg fights qWarning and printf
#   modernize-use-auto, modernize-loop-convert, modernize-pass-by-value,
#   modernize-return-braced-init-list
#       real style changes rather than mechanical ones, and against the house
#       convention of naming the type
#   misc-non-private-member-variables-in-classes
#       the *Private classes and the profile structs are plain aggregates on
#       purpose
#   readability-simplify-boolean-expr is enabled, but note that applying its
#       fixes unattended is not safe around floating point: it will rewrite
#       "!(x >= lo && x <= hi)" into "x < lo || x > hi", which is equivalent for
#       every value except NaN - and NaN is usually exactly what such a test is
#       there to catch. Read that one before taking it.
#   readability-redundant-access-specifiers
#       unsafe here, and not merely noisy. Q_SLOTS expands to nothing, so the
#       "private:" that closes a "private Q_SLOTS:" section is redundant to the
#       compiler - but moc reads the unexpanded source and needs it to know where
#       the slots end. Taking those out builds a moc file that fails with "Not a
#       signal or slot declaration".
#
# This tree also uses the alternative operator spellings - "not", "and", "or" -
# throughout, which none of these checks object to.
#
# Run through scripts/static-analysis.sh, which supplies the include paths.

Checks: >
  -*,
  bugprone-assert-side-effect,
  bugprone-bool-pointer-implicit-conversion,
  bugprone-branch-clone,
  bugprone-copy-constructor-init,
  bugprone-dangling-handle,
  bugprone-fold-init-type,
  bugprone-inaccurate-erase,
  bugprone-incorrect-roundings,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-macro-repeated-side-effects,
  bugprone-misplaced-widening-cast,
  bugprone-multiple-statement-macro,
  bugprone-not-null-terminated-result,
  bugprone-parent-virtual-call,
  bugprone-posix-return,
  bugprone-signed-char-misuse,
  bugprone-sizeof-container,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-string-integer-assignment,
  bugprone-suspicious-enum-usage,
  bugprone-suspicious-memset-usage,
  bugprone-suspicious-missing-comma,
  bugprone-suspicious-semicolon,
  bugprone-suspicious-string-compare,
  bugprone-swapped-arguments,
  bugprone-terminating-continue,
  bugprone-too-small-loop-variable,
  bugprone-undefined-memory-manipulation,
  bugprone-undelegated-constructor,
  bugprone-unhandled-self-assignment,
  bugprone-unused-raii,
  bugprone-unused-return-value,
  bugprone-use-after-move,
  bugprone-virtual-near-miss,
  cert-dcl21-cpp,
  cert-dcl58-cpp,
  cert-err34-c,
  cert-err52-cpp,
  cert-flp30-c,
  cert-oop58-cpp,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-deadcode.*,
  clang-analyzer-optin.cplusplus.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*,
  clang-analyzer-valist.*,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-static-assert,
  misc-unused-alias-decls,
  misc-unused-using-decls,
  misc-use-anonymous-namespace,
  modernize-deprecated-headers,
  modernize-use-equals-default,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-implicit-conversion-in-loop,
  performance-inefficient-algorithm,
  performance-inefficient-vector-operation,
  performance-move-const-arg,
  performance-no-automatic-move,
  performance-trivially-destructible,
  performance-unnecessary-value-param,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-else-after-return,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-named-parameter,
  readability-non-const-parameter,
  readability-qualified-auto,
  readability-redundant-control-flow,
  readability-redundant-member-init,
  readability-redundant-smartptr-get,
  readability-redundant-string-cstr,
  readability-simplify-boolean-expr,
  readability-static-accessed-through-instance,
  readability-static-definition-in-anonymous-namespace,
  readability-string-compare,

# moc output is generated; findings in it are not actionable here.
HeaderFilterRegex: '.*/(src|tests)/(?!\.moc|moc_).*\.h$'

WarningsAsErrors: ''

FormatStyle: none

CheckOptions:
  - key: bugprone-unused-return-value.CheckedFunctions
    value: '::std::async;::std::launder;::std::remove;::std::remove_if;::std::unique;::std::unique_ptr::release;::std::basic_string::empty;::std::vector::empty;::read;::write;::ioctl;::mmap'
  - key: bugprone-too-small-loop-variable.MagnitudeBitsUpperLimit
    value: '16'
